generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(uuid())
  phone           String     @unique
  name            String?
  role            String     @default("buyer")
  profilePhotoUrl String?
  upiId           String?
  upiDisplayName  String?
  paymentEnabled  Boolean    @default(false)
  suspended       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  societyId       String?
  flatId          String?
  auditLogs       AuditLog[]    @relation("AdminLogs")
  deviceTokens    DeviceToken[]
  refreshTokens   RefreshToken[]
  listings             Listing[]
  preOrderCampaigns    PreOrderCampaign[]
  orders               Order[]            @relation("BuyerOrders")
  reviews              Review[]
  flat                 Flat?              @relation(fields: [flatId], references: [id])
  society              Society?           @relation(fields: [societyId], references: [id])
}

model Society {
  id         String    @id @default(uuid())
  name       String
  city       String
  inviteCode String    @unique
  address    String?
  state      String?
  pincode    String?
  logoUrl    String?
  status     String    @default("active")
  /// UI label for building subdivision: "Block" or "Wing"
  unitLabel  String    @default("Block")
  blocks     Block[]
  flats      Flat[]
  listings            Listing[]
  preOrderCampaigns   PreOrderCampaign[]
  orders              Order[]
  users               User[]
}

model Block {
  id        String  @id @default(uuid())
  name      String
  societyId String
  society   Society @relation(fields: [societyId], references: [id])
}

model Flat {
  id         String  @id @default(uuid())
  flatNumber String
  block      String
  floor      Int
  unit       String
  societyId  String
  society    Society @relation(fields: [societyId], references: [id])
  users      User[]

  @@unique([societyId, flatNumber])
}

model Listing {
  id             String      @id @default(uuid())
  sellerId       String
  societyId      String
  name           String
  description    String?
  price          Float
  quantity       Int         @default(1)
  weightUnit     String?
  weightValue    String?
  tags           String[]    @default([])
  category       String?
  availableAt    DateTime?
  pickupLocation String      @default("My Home (Verified)")
  imageUrl       String?
  /// active | paused | expired | sold_out | inactive
  status         String      @default("active")
  featured       Boolean     @default(false)
  /// When set, this listing is a pre-order campaign product, not a regular listing.
  campaignId     String?
  /// demand | limited — only for campaign products. Regular listings ignore this.
  inventoryMode  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  seller         User        @relation(fields: [sellerId], references: [id])
  society        Society     @relation(fields: [societyId], references: [id])
  campaign       PreOrderCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  reviews        Review[]

  @@index([societyId, status])
  @@index([sellerId])
  @@index([campaignId])
}

/// Seller-created future offering. Products are Listings with campaignId set.
model PreOrderCampaign {
  id                       String    @id @default(uuid())
  sellerId                 String
  societyId                String
  title                    String
  description              String?
  coverImageUrl            String?
  fulfilmentNotes          String?
  orderOpenAt              DateTime
  orderCutoffAt            DateTime
  fulfilmentAt             DateTime
  /// draft | open | closed | cancelled
  status                   String    @default("draft")
  /// pickup | seller_delivery
  offeredFulfilmentMethods String[]  @default(["pickup"])
  /// Default used when the buyer chooses seller_delivery; snapshotted onto Order.deliveryCharge.
  defaultDeliveryCharge    Float     @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  seller                   User      @relation(fields: [sellerId], references: [id])
  society                  Society   @relation(fields: [societyId], references: [id])
  products                 Listing[]
  orders                   Order[]

  @@index([societyId, status])
  @@index([sellerId])
}

model Order {
  id                    String      @id @default(uuid())
  orderNumber           String      @unique
  buyerId               String
  societyId             String
  /// regular | pre_order
  type                  String      @default("regular")
  campaignId            String?
  /// pickup | seller_delivery — buyer choice; null for regular orders.
  fulfilmentMethod      String?
  /// Historical charge for this order. 0 for pickup / regular.
  deliveryCharge        Float       @default(0)
  fulfilmentNotes       String?
  /// Snapshot of campaign.fulfilmentAt at place-order time.
  fulfilmentAt          DateTime?
  status                String      @default("pending")
  paymentMethod         String      @default("upi")
  subtotal              Float
  /// Stored fee amount charged on this order (platform fee).
  communityFee          Float       @default(0)
  total                 Float
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  acceptedAt            DateTime?
  preparingAt           DateTime?
  readyAt               DateTime?
  /// Optional seller estimate for when order will be ready (informational only).
  expectedReadyAt       DateTime?
  pickedUpAt            DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  paymentStatus         String      @default("pending")
  buyerMarkedPaidAt     DateTime?
  sellerConfirmedPaidAt DateTime?
  upiTransactionRef     String?
  rejectReason          String?
  rejectedAt            DateTime?
  rejectedBy            String?
  buyer                 User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  society               Society     @relation(fields: [societyId], references: [id])
  campaign              PreOrderCampaign? @relation(fields: [campaignId], references: [id])
  items                 OrderItem[]
  reviews               Review[]

  @@index([buyerId, createdAt])
  @@index([societyId, status])
  @@index([campaignId])
  @@index([type])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  listingId String
  quantity  Int
  unitPrice Float
  listing   Listing @relation(fields: [listingId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([listingId])
}

model Review {
  id              String   @id @default(uuid())
  orderId         String
  listingId       String
  reviewerId      String
  rating          Int
  comment         String?
  tags            String[]
  wouldOrderAgain Boolean  @default(true)
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())
  listing         Listing  @relation(fields: [listingId], references: [id])
  order           Order    @relation(fields: [orderId], references: [id])
  reviewer        User     @relation(fields: [reviewerId], references: [id])

  @@unique([orderId, reviewerId])
  @@index([listingId])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminLogs", fields: [adminId], references: [id])
}

/// Key/value platform config (e.g. platform_fee).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// FCM device tokens for push notifications (multi-device).
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String?
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

/// Hashed refresh tokens for 2Factor persistent login. Firebase login is unchanged.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
