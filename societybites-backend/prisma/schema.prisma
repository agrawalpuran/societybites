generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                  @id @default(uuid())
  phone                   String                  @unique
  name                    String?
  role                    String                  @default("buyer")
  profilePhotoUrl         String?
  upiId                   String?
  upiDisplayName          String?
  paymentEnabled          Boolean                 @default(false)
  /// MY_SOCIETY | NEARBY | EXTENDED. Radius km lives on CityReachConfig, not here.
  sellingReachLevel       String                  @default("MY_SOCIETY")
  /// BUYER_PICKUP | SELLER_DELIVERY | BOTH. Independent of sellingReachLevel.
  fulfilmentMode          String                  @default("BUYER_PICKUP")
  /// Legacy / nearby alias. Prefer the per-reach fields below.
  deliveryCharge          Float                   @default(0)
  /// Seller-stated delivery charges by buyer reach. In-society defaults to 0.
  deliveryChargeInSociety Float                   @default(0)
  deliveryChargeNearby    Float                   @default(0)
  deliveryChargeExtended  Float                   @default(0)
  /// UPI_ONLY | UPI_AND_COD | COD_IN_SOCIETY_UPI_OUTSIDE. Controls NEW checkout options only; orders snapshot paymentMethod.
  paymentPreference       String                  @default("COD_IN_SOCIETY_UPI_OUTSIDE")
  /// Daily kitchen window in IST, "HH:mm". Both null means always open.
  kitchenOpensAt          String?
  kitchenClosesAt         String?
  /// Capture-only FSSAI licence. No approval or enforcement.
  fssaiNumber             String?
  fssaiExpiry             DateTime?
  fssaiRegisteredName     String?
  /// Seller address verification document (URL from media upload).
  addressProofUrl         String?
  /// PENDING | OK | FOLLOW_UP. Null with a photo means not reviewed yet.
  addressProofStatus      String?
  addressProofReviewedAt  DateTime?
  /// Admin user id that last marked the photo. Does not change selling.
  addressProofReviewedBy  String?
  suspended               Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  societyId               String?
  flatId                  String?
  auditLogs               AuditLog[]              @relation("AdminLogs")
  deviceTokens            DeviceToken[]
  refreshTokens           RefreshToken[]
  listings                Listing[]
  preOrderCampaigns       PreOrderCampaign[]
  orders                  Order[]                 @relation("BuyerOrders")
  reviews                 Review[]
  sentMessages            Message[]
  sellerTermsAcceptances  SellerTermsAcceptance[]
  issueReports            IssueReport[]
  issueMessages           IssueMessage[]
  couponRedemptions       CouponRedemption[]
  couponEligibilities     CouponEligibleUser[]
  orderIdempotencies      OrderIdempotency[]
  sellerFssai             SellerFssai?
  fssaiAssistanceRequests FssaiAssistanceRequest[]
  fssaiReviews            SellerFssai[]           @relation("FssaiReviewedBy")
  flat                    Flat?                   @relation(fields: [flatId], references: [id])
  society                 Society?                @relation(fields: [societyId], references: [id])
}

/// One current FSSAI registration record per seller (review workflow).
model SellerFssai {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  registrationNumber       String?
  registeredName           String?
  licenceExpiry            DateTime?
  /// Private object path in Supabase storage (not a public URL).
  documentStorageReference String?
  documentType             String?
  /// NOT_SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED
  status                   String    @default("NOT_SUBMITTED")
  rejectionReason          String?
  submittedAt              DateTime?
  reviewedAt               DateTime?
  reviewedBy               String?
  needsAssistance          Boolean   @default(false)
  /// Seller chose "no details now" while FSSAI selling requirement is off.
  detailsDeferred          Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer                 User?     @relation("FssaiReviewedBy", fields: [reviewedBy], references: [id])

  @@index([status, submittedAt])
}

/// Lightweight seller request for help obtaining FSSAI registration.
model FssaiAssistanceRequest {
  id          String   @id @default(uuid())
  userId      String
  societyId   String?
  /// NEW | CONTACTED | IN_PROGRESS | COMPLETED
  status      String   @default("NEW")
  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  society     Society? @relation(fields: [societyId], references: [id])

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

/// Record that a user accepted a seller-terms version. Existing sellers are not required to have a row.
model SellerTermsAcceptance {
  id           String   @id @default(uuid())
  userId       String
  termsVersion String
  /// Set by the server when acceptance is stored. Clients cannot supply this.
  acceptedAt   DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion])
  @@index([userId])
}

model Society {
  id                String             @id @default(uuid())
  name              String
  city              String
  inviteCode        String             @unique
  address           String?
  state             String?
  pincode           String?
  logoUrl           String?
  status            String             @default("active")
  /// UI label for building subdivision: "Block" or "Wing"
  unitLabel         String             @default("Block")
  /// Google Place ID of the real-world society. Discovery only — SocietyBites id remains source of truth.
  googlePlaceId     String?            @unique
  /// Society location (not the user's live GPS).
  latitude          Float?
  longitude         Float?
  blocks            Block[]
  flats             Flat[]
  listings          Listing[]
  preOrderCampaigns PreOrderCampaign[]
  orders            Order[]
  users             User[]
  fssaiAssistance   FssaiAssistanceRequest[]
}

model Block {
  id        String  @id @default(uuid())
  name      String
  societyId String
  society   Society @relation(fields: [societyId], references: [id])
}

model Flat {
  id         String  @id @default(uuid())
  flatNumber String
  block      String
  floor      Int
  unit       String
  societyId  String
  society    Society @relation(fields: [societyId], references: [id])
  users      User[]

  @@unique([societyId, flatNumber])
}

model Listing {
  id                     String            @id @default(uuid())
  sellerId               String
  societyId              String
  name                   String
  description            String?
  price                  Float
  quantity               Int               @default(1)
  weightUnit             String?
  weightValue            String?
  tags                   String[]          @default([])
  /// VEG | NON_VEG. Nullable for listings created before this field existed.
  foodType               String?
  category               String?
  /// Multi-select food occasions. Display labels: Breakfast, Lunch, Dinner, Snacks, Desserts.
  categories             String[]          @default([])
  availableAt            DateTime?
  pickupLocation         String            @default("My Home (Verified)")
  imageUrl               String?
  /// active | paused | expired | sold_out | inactive
  status                 String            @default("active")
  featured               Boolean           @default(false)
  /// REGULAR | PREORDER. Marketplace vs seller pre-order catalog. Independent of campaignId.
  catalogType            String            @default("REGULAR")
  /// READY_NOW | MADE_TO_ORDER. Only meaningful for REGULAR catalog listings.
  availabilityMode       String            @default("READY_NOW")
  /// Estimate in minutes for MADE_TO_ORDER. Seller still confirms the actual ready time.
  preparationTimeMinutes Int?
  /// Optional cap on accepted MADE_TO_ORDER orders per UTC day. Null = no cap.
  maxDailyOrders         Int?
  /// REGULAR + READY_NOW only. Existing listings stay false.
  recurringEnabled       Boolean           @default(false)
  /// ISO weekdays 1=Mon … 7=Sun. Empty unless recurringEnabled.
  recurringWeekdays      Int[]             @default([])
  /// Minutes from IST midnight. Inclusive start of selling window.
  recurringStartMinute   Int?
  /// Minutes from IST midnight. Exclusive end of selling window (start < end).
  recurringEndMinute     Int?
  /// Optional portions per IST selling day. Null = no daily cap.
  recurringDailyLimit    Int?
  /// When set, this listing is a pre-order campaign product, not a regular listing.
  campaignId             String?
  /// Catalog listing this campaign product was copied from. Null for ad-hoc / historical copies.
  sourceListingId        String?
  /// demand | limited — only for campaign products. Regular listings ignore this.
  inventoryMode          String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  seller                 User              @relation(fields: [sellerId], references: [id])
  society                Society           @relation(fields: [societyId], references: [id])
  campaign               PreOrderCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceListing          Listing?          @relation("ListingCampaignSource", fields: [sourceListingId], references: [id], onDelete: SetNull)
  campaignCopies         Listing[]         @relation("ListingCampaignSource")
  orderItems             OrderItem[]
  reviews                Review[]

  @@index([societyId, status])
  @@index([sellerId])
  @@index([campaignId])
  @@index([sourceListingId])
}

/// Seller-created future offering. Products are Listings with campaignId set.
model PreOrderCampaign {
  id                       String    @id @default(uuid())
  sellerId                 String
  societyId                String
  title                    String
  description              String?
  coverImageUrl            String?
  fulfilmentNotes          String?
  orderOpenAt              DateTime
  orderCutoffAt            DateTime
  fulfilmentAt             DateTime
  /// draft | open | closed | cancelled
  status                   String    @default("draft")
  /// pickup | seller_delivery
  offeredFulfilmentMethods String[]  @default(["pickup"])
  /// Default used when the buyer chooses seller_delivery; snapshotted onto Order.deliveryCharge.
  defaultDeliveryCharge    Float     @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  seller                   User      @relation(fields: [sellerId], references: [id])
  society                  Society   @relation(fields: [societyId], references: [id])
  products                 Listing[]
  orders                   Order[]

  @@index([societyId, status])
  @@index([sellerId])
}

model Order {
  id                    String             @id @default(uuid())
  orderNumber           String             @unique
  buyerId               String
  societyId             String
  /// regular | pre_order
  type                  String             @default("regular")
  campaignId            String?
  /// pickup | seller_delivery — buyer choice; null for regular orders.
  fulfilmentMethod      String?
  /// Historical charge for this order. 0 for pickup / regular.
  deliveryCharge        Float              @default(0)
  fulfilmentNotes       String?
  /// Snapshot of campaign.fulfilmentAt at place-order time.
  fulfilmentAt          DateTime?
  status                String             @default("pending")
  paymentMethod         String             @default("upi")
  subtotal              Float
  /// Stored fee amount charged on this order (platform fee).
  communityFee          Float              @default(0)
  total                 Float
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  acceptedAt            DateTime?
  preparingAt           DateTime?
  readyAt               DateTime?
  /// Optional seller estimate for when order will be ready (informational only).
  expectedReadyAt       DateTime?
  /// Optional buyer request for when they need the order (Made to Order only).
  requestedReadyAt      DateTime?
  pickedUpAt            DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  paymentStatus         String             @default("pending")
  buyerMarkedPaidAt     DateTime?
  sellerConfirmedPaidAt DateTime?
  upiTransactionRef     String?
  rejectReason          String?
  rejectedAt            DateTime?
  rejectedBy            String?
  /// Buyer cancellation reason (reason line, optional note on second line).
  cancelReason          String?
  buyer                 User               @relation("BuyerOrders", fields: [buyerId], references: [id])
  society               Society            @relation(fields: [societyId], references: [id])
  campaign              PreOrderCampaign?  @relation(fields: [campaignId], references: [id])
  items                 OrderItem[]
  reviews               Review[]
  messages              Message[]
  couponRedemptions     CouponRedemption[]
  idempotencyRecord     OrderIdempotency?

  @@index([buyerId, createdAt])
  @@index([societyId, status])
  @@index([campaignId])
  @@index([type])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  listingId String
  quantity  Int
  unitPrice Float
  listing   Listing @relation(fields: [listingId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([listingId])
}

/// One row per buyer + Idempotency-Key; completed rows replay the linked order.
model OrderIdempotency {
  id             String   @id @default(uuid())
  buyerId        String
  idempotencyKey String
  orderId        String?  @unique
  /// PENDING | COMPLETED | FAILED
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  buyer          User     @relation(fields: [buyerId], references: [id])
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId])
}

model Review {
  id              String   @id @default(uuid())
  orderId         String
  listingId       String
  reviewerId      String
  rating          Int
  comment         String?
  tags            String[]
  wouldOrderAgain Boolean  @default(true)
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())
  listing         Listing  @relation(fields: [listingId], references: [id])
  order           Order    @relation(fields: [orderId], references: [id])
  reviewer        User     @relation(fields: [reviewerId], references: [id])

  @@unique([orderId, reviewerId])
  @@index([listingId])
}

model Message {
  id        String    @id @default(uuid())
  orderId   String
  senderId  String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])

  @@index([orderId, createdAt])
  @@index([orderId, readAt])
  @@index([senderId])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminLogs", fields: [adminId], references: [id])
}

/// Per-city Level 2 / Level 3 selling radii. cityKey is canonicalCityKey(city).
/// Do not store these radii on User. Validation: nearby > 0, extended > nearby.
model CityReachConfig {
  cityKey          String   @id
  displayName      String
  nearbyRadiusKm   Float
  extendedRadiusKm Float
  updatedAt        DateTime @updatedAt
}

/// Key/value platform config (e.g. platform_fee).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// FCM device tokens for push notifications (multi-device).
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String?
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

/// In-app issue and feedback reports. Isolated from orders, listings, and payments.
model IssueReport {
  id               String         @id @default(uuid())
  issueNumber      Int            @unique @default(autoincrement())
  reference        String         @unique
  userId           String
  /// Role captured from the authenticated user at submission time.
  userRole         String
  category         String
  description      String
  orderId          String?
  listingId        String?
  sellerId         String?
  /// OPEN | UNDER_REVIEW | RESOLVED | CLOSED
  status           String         @default("OPEN")
  adminResponse    String?
  /// When SocietyEats last wrote a reply. Null until the first reply.
  adminRespondedAt DateTime?
  /// Optional photo attached to the original report.
  imageUrl         String?
  /// ANDROID | IOS | WEB
  platform         String?
  appVersion       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resolvedAt       DateTime?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         IssueMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// One entry in an issue thread. The original report is the first USER message.
model IssueMessage {
  id         String      @id @default(uuid())
  issueId    String
  authorId   String
  /// USER | SOCIETYEATS
  authorRole String
  body       String
  imageUrl   String?
  createdAt  DateTime    @default(now())
  issue      IssueReport @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

/// Hashed refresh tokens for 2Factor persistent login. Firebase login is unchanged.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CouponDiscountType {
  FIXED
  PERCENTAGE
}

enum CouponAudienceType {
  ALL
  SELECTED_USERS
}

enum CouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  EXHAUSTED
}

enum CouponFundedBy {
  SOCIETYEATS
}

enum CouponUsageFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum CouponRedemptionStatus {
  APPLIED
  REDEEMED
  REVERSED
}

/// SocietyEats-funded promotion. Seller entitlement is not reduced by the discount.
model Coupon {
  id                 String                @id @default(uuid())
  code               String                @unique
  name               String
  description        String?
  discountType       CouponDiscountType
  discountValue      Float
  maximumDiscount    Float?
  minimumOrderValue  Float                 @default(0)
  validFrom          DateTime
  validUntil         DateTime
  totalUsageLimit    Int?
  usagePerBuyerLimit Int?
  usageFrequency     CouponUsageFrequency?
  campaignBudget     Float?
  audienceType       CouponAudienceType    @default(ALL)
  status             CouponStatus          @default(DRAFT)
  fundedBy           CouponFundedBy        @default(SOCIETYEATS)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  redemptions        CouponRedemption[]
  eligibleUsers      CouponEligibleUser[]

  @@index([status, validUntil])
}

model CouponEligibleUser {
  couponId String
  userId   String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([couponId, userId])
  @@index([userId])
}

model CouponRedemption {
  id             String                 @id @default(uuid())
  couponId       String
  userId         String
  orderId        String?
  discountAmount Float
  status         CouponRedemptionStatus @default(APPLIED)
  appliedAt      DateTime               @default(now())
  redeemedAt     DateTime?
  reversedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  coupon         Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId, userId, status])
  @@index([couponId, status])
  @@index([orderId])
}
