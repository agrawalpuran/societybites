# Database
# Runtime (Render + local app): Supabase Transaction Pooler, port 6543.
# Copy the Transaction pooler URI from Supabase, then add pgbouncer=true and connection_limit=3.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3"
DATABASE_URL=

# Prisma CLI / migrate / db push / Studio only — not used by the Node process at runtime.
# Prefer the Direct connection (db.<project>.supabase.co:5432).
# If IPv6-direct fails, use Session pooler port 5432 with connection_limit=1.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL=

# JWT (existing firebase-login access token)
JWT_SECRET=
JWT_EXPIRY=7d

# 2Factor OTP (optional until cutover — firebase-login does not need these)
TWOFACTOR_API_KEY=
# TWOFACTOR_OTP_TEMPLATE=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_TTL_MS=2592000000
# OTP_TTL_MS=600000
# OTP_RESEND_COOLDOWN_MS=60000
# OTP_MAX_SENDS_PER_HOUR=5
# OTP_MAX_VERIFY_ATTEMPTS=5

# Firebase Admin (Auth verify + FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=production

# Storage (Supabase Storage — required for listing/campaign images)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images
