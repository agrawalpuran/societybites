# Database
# Runtime (Render + local app): Supabase Transaction Pooler, port 6543.
# Copy the Transaction pooler URI from Supabase, then add pgbouncer=true and connection_limit=3.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3"
DATABASE_URL=

# Prisma CLI / migrate / db push / Studio only — not used by the Node process at runtime.
# Prefer the Direct connection (db.<project>.supabase.co:5432).
# If IPv6-direct fails, use Session pooler port 5432 with connection_limit=1.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL=

# JWT (existing firebase-login access token)
JWT_SECRET=
JWT_EXPIRY=7d

# 2Factor OTP (optional until cutover — firebase-login does not need these)
TWOFACTOR_API_KEY=
# TWOFACTOR_OTP_TEMPLATE=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_TTL_MS=2592000000
# OTP_TTL_MS=600000
# OTP_RESEND_COOLDOWN_MS=60000
# OTP_MAX_SENDS_PER_HOUR=5
# OTP_MAX_VERIFY_ATTEMPTS=5

# Test OTP bypass (local and Render testing). Do not leave enabled for real users.
# If missing or not true, bypass is fully off and every number uses 2Factor.
# Numbers and OTP stay on the backend — never put these in Flutter or API responses.
# Render: add the same three keys on the backend service (Environment), set
# TEST_OTP_ENABLED=true, then save so the next deploy/restart picks them up.
TEST_OTP_ENABLED=false
TEST_PHONE_NUMBERS=1111111111,2222222222,3333333333,4444444444,5555555555,6666666666,7777777777,8888888888,9999999999
TEST_OTP=123456

# Firebase Admin (Auth verify + FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=production

# Google Places API (New) — server-side only. Never put this key in Flutter.
# Required for "Find Your Society" discovery. SocietyBites remains source of truth.
#
# Google Cloud setup (manual — cannot be done from this repo):
# 1. Create/select a Google Cloud project with billing enabled (Places is a paid API).
# 2. Enable "Places API (New)" (places.googleapis.com).
# 3. Create an API key, then restrict it:
#    - API restriction: Places API (New) only
#    - Application restriction: your backend IPs / Render outbound IPs (not unrestricted)
# 4. Set the key here and on the Render backend service. Do not commit the real key.
# 5. Apply the Prisma migration `20260828120000_add_society_google_place_fields` before using this in production.
#
# Optional: ISO 3166-1 alpha-2 region. Defaults to SOCIETY_LAUNCH_COUNTRY (IN).
# GOOGLE_PLACES_REGION_CODE=IN
GOOGLE_PLACES_API_KEY=

# Society discovery launch city (backend only — never sent to Flutter).
# Change these to expand later without rebuilding the app.
# Render: set the same three values on the backend service.
SOCIETY_LAUNCH_CITY=Bengaluru
SOCIETY_LAUNCH_STATE=Karnataka
SOCIETY_LAUNCH_COUNTRY=IN
# Optional bias override (meters). If omitted, Bengaluru uses a built-in circle.
# SOCIETY_LAUNCH_LAT=12.9716
# SOCIETY_LAUNCH_LNG=77.5946
# SOCIETY_LAUNCH_RADIUS_M=40000

# Storage (Supabase Storage — required for listing/campaign images)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images
