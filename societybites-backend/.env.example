# Database
DATABASE_URL=

# JWT (existing firebase-login access token)
JWT_SECRET=
JWT_EXPIRY=7d

# 2Factor OTP (optional until cutover — firebase-login does not need these)
TWOFACTOR_API_KEY=
# TWOFACTOR_OTP_TEMPLATE=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_TTL_MS=2592000000
# OTP_TTL_MS=600000
# OTP_RESEND_COOLDOWN_MS=60000
# OTP_MAX_SENDS_PER_HOUR=5
# OTP_MAX_VERIFY_ATTEMPTS=5

# Firebase Admin (Auth verify + FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=production

# Storage (future: Supabase Storage)
# SUPABASE_URL=
# SUPABASE_KEY=
